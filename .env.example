# Server-side only. Never prefix these with VITE_ — that would expose them to the browser bundle.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# CHECKPOINT C2G — Cloudflare Turnstile (see src/server/turnstile.server.ts).
# Server-only. Read per-request via process.env, same mechanism as the
# Supabase vars above — see env.server.ts's own doc comment for why.
#
# Cloudflare's own publicly documented dummy TEST secret keys (safe to use
# locally, never real, never point at a real site) — see
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/ :
#   always passes:  1x0000000000000000000000000000000AA
#   always blocks:  2x0000000000000000000000000000000AA
#   always errors:  3x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Comma-separated exact hostnames Siteverify is allowed to have observed the
# widget on (e.g. localhost,preview.example.com,www.example.com). Never a
# wildcard.
TURNSTILE_ALLOWED_HOSTNAMES=

# CHECKPOINT C2G — public, build-time only. Baked into the client bundle by
# Vite (import.meta.env), safe to expose by design — this is the PUBLIC site
# key, never the secret. Must be prefixed VITE_ to be exposed; do not add any
# other VITE_-prefixed variable to this file without confirming it's meant
# to be public.
#
# Cloudflare's own publicly documented dummy TEST site keys (pair with the
# TEST secret keys above):
#   always passes (managed, non-interactive): 1x00000000000000000000AA
#   always blocks:                            2x00000000000000000000AB
#   forces an interactive challenge:          3x00000000000000000000FF
VITE_TURNSTILE_SITE_KEY=

# CHECKPOINT C2H-B1 — owner-notification email (see
# src/server/notifications/dispatch-notification.server.ts and
# src/server/env.server.ts's getEmailConfig()). Server-only, read lazily and
# only from inside the dispatcher — never at application startup, so a
# missing value here cannot break the build, unit tests, or Quote
# completion. Names only below; no real key, domain, or address committed.
# See docs/owner-email-setup.md for the full setup checklist.
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=
EMAIL_FROM=
# Optional.
EMAIL_REPLY_TO=
# Optional — only rendered as a link in the owner email when set.
OWNER_DASHBOARD_URL=
